Description=WireGuard Dashboard Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/local/bin/wg-dashboard
ExecStart=python3 /usr/local/bin/wg-dashboard/wg_dashboard.py --bind 0.0.0.0 --port 8080 --interval 5 --names /usr/local/bin/wg-dashboard/peers.txt
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
